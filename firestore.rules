rules_version = '2';

// AeroLogger keeps everything under users/{uid}: your profile, logbooks,
// their galleries and photos. Only you can read or change yours. (Before
// these rules, anyone on the internet could read everyone's profile.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Anything else: nobody.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
