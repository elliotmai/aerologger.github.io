rules_version = '2';

// Photos live at users/{uid}/logbooks/…; only their owner reads or writes them
// (download links the app already saved keep working: they carry their own token).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
