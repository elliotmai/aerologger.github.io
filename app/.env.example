# Optional Firebase module. To enable:
#   1. npm install firebase
#   2. Copy this file to .env.local and fill in the values below
#   3. import { initFirebase, auth, db } from '@/lib/firebase'
# Leaving these blank keeps Firebase disabled (the module no-ops).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
